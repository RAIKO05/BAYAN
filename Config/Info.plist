<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>Bayan</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>tools.rea.Bayan</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>Bayan</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.1.0</string>
    <key>CFBundleVersion</key>
    <string>2</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    
    <!-- Microphone Permission for Quran Recognition -->
    <key>NSMicrophoneUsageDescription</key>
    <string>Bayan requires microphone access to listen to and recognize Quranic recitations.</string>
    
    <!-- Location Permission for Qibla Compass Direction -->
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Bayan requires location access to calculate the exact direction to the Holy Kaaba (Qibla) and local prayer times from your current location.</string>

    <!-- Speech Recognition for Recitation Identification -->
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>Bayan uses speech recognition to accurately identify recited Quranic verses in real time.</string>
    
    <!-- Background Audio Recitation Mode -->
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
    </array>
    
    <!-- Custom URL Scheme for Control Center and Shortcuts (bayan://) -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>CFBundleURLName</key>
            <string>tools.rea.Bayan</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>bayan</string>
            </array>
        </dict>
    </array>
    
    <!-- Bundled Authentic Quran Calligraphy Font -->
    <key>UIAppFonts</key>
    <array>
        <string>AmiriQuran-Regular.ttf</string>
    </array>
    
    <!-- Launch Screen & Orientation -->
    <key>UILaunchScreen</key>
    <dict>
        <key>UIColorName</key>
        <string>black</string>
    </dict>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UIRequiresFullScreen</key>
    <false/>
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
    <key>NSSupportsLiveActivities</key>
    <true/>
    <key>NSSupportsLiveActivitiesFrequentUpdates</key>
    <true/>
    
    <!-- Local Network & Bonjour Services for Multi-Platform Casting (AirPlay, Android Google Cast, Windows DLNA) -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>Bayan discovers AirPlay, Google Cast, and Windows DLNA devices on your Wi-Fi network so you can cast Quran recitations.</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_googlecast._tcp</string>
        <string>_airplay._tcp</string>
        <string>_raop._tcp</string>
    </array>
</dict>
</plist>
